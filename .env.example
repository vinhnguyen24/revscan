# TrapKey environment variables
# Copy to .env and fill in your values. All are optional.

# --- AI Provider (for --ai flag) ---
# Static scan needs NO key. Only --ai uses these.

# Provider: openai | ollama | anthropic | gemini
TRAPKEY_AI_PROVIDER=openai

# OpenAI-compatible (also works with DeepSeek, Groq, Together, OpenRouter, vLLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
TRAPKEY_AI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (AI Studio)
# TRAPKEY_AI_PROVIDER=gemini
# GEMINI_API_KEY=...
# TRAPKEY_AI_MODEL=gemini-2.0-flash
# TRAPKEY_AI_THINKING_BUDGET=0

# Ollama (local, free)
# TRAPKEY_AI_PROVIDER=ollama
# TRAPKEY_AI_MODEL=qwen2.5-coder:7b

# Ollama Cloud
# OLLAMA_API_KEY=...
# TRAPKEY_AI_MODEL=gpt-oss:120b

# --- AI Tuning ---
# TRAPKEY_AI_MAX_TOKENS=1200          # Output token budget (default 1200)
# TRAPKEY_AI_TIMEOUT=120              # Socket timeout in seconds (default 120)
# TRAPKEY_AI_REASONING_EFFORT=low     # For reasoning models
# TRAPKEY_AI_CODE=0                   # Disable IL/objdump in evidence pack

# --- Calibration ---
# Fitted multiplier from calibrate.py. Default 1.0.
# TRAPKEY_CALIBRATION_K=1.2673
# TRAPKEY_CALIBRATION_MODEL=cloud-fast

# --- Web Server ---
# PORT=7200
# HOST=127.0.0.1
# PUBLIC_URL=https://yourdomain.com
# DATA_DIR=./web-data

# --- Auth & Billing (optional) ---
# ADMIN_KEY=                          # Auto-generated to web-data/admin.key if not set
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_AUDIT=price_...
# STRIPE_PRICE_ANNUAL=price_...
# RESEND_API_KEY=re_...               # Without this, login links go to web-data/outbox/
# MAIL_FROM=noreply@yourdomain.com

# --- Limits ---
# MAX_CONCURRENT_SCANS=4
# SCAN_TIMEOUT_MS=60000
# COMPARE_TIMEOUT_MS=30000
# TRAPKEY_RETENTION_DAYS=180
